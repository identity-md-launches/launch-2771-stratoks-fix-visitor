# Delivery evidence has an explicit 2 MiB budget; see artifacts/phase2b/RELEASE.json.
# Override the workspace exclusion only for this assignment's evidence.
!artifacts/
artifacts/*
!artifacts/phase2b/
!artifacts/phase2b/**

# Installed packages and build caches never belong in the delivery, at any depth.
**/node_modules/
**/.vite/
**/.npm/
**/.cache/

# Local runtime state and secrets are never published.
/test/
/data/
/data-expanse/
/backups/
.env
.env.*
!.env.example
*.key
*.pem

# Interface evidence and patch: artifacts/overhaul/** has an explicit 4 MiB budget.
# The historical 4 MiB runtime allowance is superseded by the living budgets below.
!artifacts/overhaul/
!artifacts/overhaul/**

# Living interface evidence: artifacts/living-interface/** has a 1664 KiB budget.
# Runtime assets + checkpoint source/export have a separate 6.125 MiB path budget
# across web/public/art/**, web/public/demo/** and dist/**; no dependencies here.
!artifacts/living-interface/
!artifacts/living-interface/**

# Agency integration evidence has an explicit 1310720-byte (1.25 MiB) path budget.
# Source/runtime additions plus this evidence remain inside the task's 8 MiB bundle.
!artifacts/agency-interface/
!artifacts/agency-interface/**

# Visitor HUD validation/screenshots: explicit combined path budget 1048576 bytes.
!artifacts/visitor-auth/
!artifacts/visitor-auth/**

# Session recovery evidence/screenshots: explicit combined path budget 2097152 bytes.
!artifacts/visitor-recovery/
!artifacts/visitor-recovery/**
