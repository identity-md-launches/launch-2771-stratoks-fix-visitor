# Terminates TLS and routes the Expanse API to the private 8788 backend. Bind that backend to loopback/private networking only.
{$SERVER_HOSTNAME} {
	encode zstd gzip
	handle /api/auth/* {
		reverse_proxy 127.0.0.1:8788 {
			header_up X-Forwarded-For {remote_host}
		}
	}
	handle /api/expanse/* {
		reverse_proxy 127.0.0.1:8788
	}
	handle /healthz {
		reverse_proxy 127.0.0.1:8788
	}
	handle {
		root * /srv/stratoks/dist
		file_server
	}
}
